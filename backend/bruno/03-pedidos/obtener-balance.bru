meta {
  name: Obtener balance
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/pedidos/balance?periodo=hoy
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

docs {
  Agregados de ventas + gastos: periodo=hoy|semana|mes.
  Semana = lunes→hoy (UTC). Mes = día 1→hoy.
  Incluye cobrado_efectivo / cobrado_transferencia, gastos y ganancia.
}
