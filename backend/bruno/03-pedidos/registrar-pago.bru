meta {
  name: Registrar pago
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/pedidos/1/pago
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "monto_pagado": 30000,
    "es_transferencia": false
  }
}

assert {
  res.status: eq 200
  res.body.estado: eq pendiente
}

docs {
  Paga al menos el total del pedido. es_transferencia opcional (default false = efectivo).
}
