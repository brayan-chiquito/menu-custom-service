meta {
  name: Crear pedido
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/pedidos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre_cliente": "Ana",
    "items": [
      {
        "producto_id": 2,
        "cantidad": 1,
        "base_id": 1,
        "salsa_ids": [4],
        "proteina_id": 1,
        "adiciones": [4]
      }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.estado: eq pendiente
}

docs {
  Ejemplo Candente (requiere_proteina): base Maduro, salsas BBQ (puede ir más de una), proteína Carne, Guacamole.
  Ajusta IDs según GET /menu.
}
