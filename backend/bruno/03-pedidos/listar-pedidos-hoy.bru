meta {
  name: Listar pedidos hoy
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/pedidos?fecha=hoy
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

docs {
  Lista pedidos del día calendario America/Bogotá.
  Respuesta: array de resúmenes sin items.
  Para todos los días use listar-pedidos-paginado.
}
