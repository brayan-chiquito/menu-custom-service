meta {
  name: Crear pedido sin nombre (sin proteina)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/pedidos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre_cliente": "",
    "items": [
      {
        "producto_id": 4,
        "cantidad": 1,
        "base_id": 1,
        "salsa_ids": [1, 4],
        "proteina_id": null,
        "adiciones": []
      }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.nombre_cliente: eq Sin nombre
}

docs {
  Apoteósico trae Carne y Pollo: requiere_proteina=false → proteina_id null.
  salsa_ids admite una o más salsas (aquí Ajo + BBQ).
}
