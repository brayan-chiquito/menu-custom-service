meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "usuario": "admin",
    "password": "Admin123!"
  }
}

docs {
  Devuelve token Bearer para Bruno y Set-Cookie httpOnly para el navegador.
  La PWA no guarda el token. Password de ejemplo del seed: Admin123!
}
