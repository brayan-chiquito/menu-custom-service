meta {
  name: Registrar egreso
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/egresos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Platano",
    "precio": 2000,
    "cantidad": 3
  }
}

assert {
  res.status: eq 201
  res.body.total: eq 6000
}

docs {
  Crea un egreso. total = precio × cantidad.
}
