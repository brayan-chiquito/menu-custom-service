# Número que RECIBE el aviso del pedido (cambiar solo este al cambiar destino).
# Código país + número, sin + ni espacios. Ejemplo Colombia: 573001234567
WHATSAPP_TARGET_NUMBER=573XXXXXXXXX

# El número que ENVÍA no va aquí: es el WhatsApp que escanea el QR
# al arrancar el backend (sesión en backend/.wwebjs_auth).

VITE_API_BASE_URL=http://localhost:3000
