# API (el navegador llama al mismo origen; nginx o Vite reenvían /api al backend)
VITE_API_BASE_URL=/api

# Auth / seguridad (backend)
# REQUIRE_AUTH=1 en prod (nunca 0). En tests vitest pone 0.
# ADMIN_INITIAL_PASSWORD=  (solo el primer arranque; luego npm run reset-admin)
# SESSION_TTL_HOURS=24
# LOGIN_RATE_MAX=5
# LOGIN_RATE_WINDOW_MS=60000
# COOKIE_SECURE=1          (obligatorio detrás de HTTPS)
# CORS_ORIGINS=https://tu-dominio
# ENFORCE_PROD_CONFIG=1    (el proceso no arranca si falta lo de arriba)

# Legacy (WhatsApp operativo retirado)
# WHATSAPP_TARGET_NUMBER=
